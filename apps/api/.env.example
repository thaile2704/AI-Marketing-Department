APP_ENV=development
# Local-only bypass for Codespaces testing. Never enable in staging/production.
DEV_AUTH_ENABLED=true
DATABASE_URL=postgresql+asyncpg://marketing:marketing_dev_only@db:5432/marketing
CORS_ORIGINS=http://localhost:3000
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
DEFAULT_MODEL_PROVIDER=openai
# Configure these when using a real OIDC provider; dev identity is only for local testing.
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_JWKS_URL=
OIDC_ORG_ROLES_CLAIM=org_roles
